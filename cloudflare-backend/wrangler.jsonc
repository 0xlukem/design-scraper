{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "design-scraper-phase8",
  "main": "src/index.ts",
  "build": { "command": "node scripts/patch-playwright-redirects.mjs" },
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "browser": { "binding": "BROWSER", "remote": true },
  "durable_objects": {
    "bindings": [
      { "name": "QUOTA", "class_name": "QuotaCoordinator" },
      { "name": "ANALYSIS", "class_name": "AnalysisSession" },
      { "name": "RESOURCE_RELAY", "class_name": "ResourceRelay" },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["QuotaCoordinator", "AnalysisSession"],
    },
    { "tag": "v2-resource-relay", "new_sqlite_classes": ["ResourceRelay"] },
  ],
  "vars": {
    "AI_PROVIDER": "gemini",
    "AI_INPUT_PRICE_USD_PER_MILLION": "0.75",
    "AI_OUTPUT_PRICE_USD_PER_MILLION": "3.75",
    "GEMINI_MODEL": "gemini-3.6-flash",
    "ALLOWED_ORIGINS": "https://design-scraper.pages.dev",
    "REQUIRE_AUTH": "false",
    "GLOBAL_DAILY_LIMIT": "20",
    "IP_HOURLY_LIMIT": "3",
    "IP_DAILY_LIMIT": "5",
    "AI_BUDGET_ENABLED": "true",
    "DAILY_AI_BUDGET_MICRO_USD": "1000000",
    "TOTAL_AI_BUDGET_MICRO_USD": "30000000",
    "MAX_CONCURRENT_ANALYSES": "1",
    "BROWSER_DAILY_MS": "480000",
    "BROWSER_START_INTERVAL_MS": "21000",
    "SCRAPE_TIMEOUT_MS": "60000",
    "AI_TIMEOUT_MS": "100000",
    "AI_ATTEMPT_TIMEOUT_MS": "60000",
    "ANALYSIS_TIMEOUT_MS": "220000",
    "MAX_AI_ATTEMPTS": "2",
    "MAX_ELEMENTS": "3000",
    "MAX_NETWORK_REQUESTS": "600",
    "MAX_REDIRECTS": "5",
    "MAX_SCREENSHOT_HEIGHT": "4000",
    "MAX_SCREENSHOT_BYTES": "2000000",
    "MAX_OUTPUT_TOKENS": "12000",
    "MAX_INPUT_TOKENS": "80000",
    "DAILY_AI_TOKEN_LIMIT": "2000000",
    "PROVIDER_FAILURE_THRESHOLD": "3",
    "PROVIDER_COOLDOWN_MS": "60000",
    "PROVIDER_CONFIG_VERSION": "3",
  },
}
